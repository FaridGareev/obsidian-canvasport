{
  "name": "obsidian-canvas-export",
  "version": "0.1.0",
  "description": "An Obsidian Canvas export plugin for HTML, PNG, JPEG, WebP, SVG, PDF, Excalidraw, Mermaid, and D2.",
  "author": "Farid Gareev <farid.gareev@my.jcu.edu.au>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "build/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node scripts/run_tests.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "canvas",
    "export",
    "html",
    "svg",
    "pdf",
    "excalidraw",
    "mermaid",
    "d2"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "pdf-lib": "^1.17.1",
    "zod": "^4.1.12"
  }
}
