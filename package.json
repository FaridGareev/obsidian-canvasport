{
  "name": "obsidian-canvasport",
  "version": "1.0.0",
  "description": "Export Obsidian Canvas files to portable web, image, document, and diagram formats.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/FaridGareev/obsidian-canvasport#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FaridGareev/obsidian-canvasport.git"
  },
  "bugs": {
    "url": "https://github.com/FaridGareev/obsidian-canvasport/issues"
  },
  "private": true,
  "type": "module",
  "main": "build/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node scripts/run_tests.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate_project.mjs",
    "verify": "npm run validate && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "canvas",
    "canvasport",
    "export",
    "html",
    "svg",
    "pdf",
    "excalidraw",
    "mermaid",
    "d2"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "pdf-lib": "^1.17.1",
    "zod": "^4.1.12"
  }
}
