		{"id":"title","type":"text","text":"# Group Background Test\n\nBackground images must clip to rounded group bounds. Cover and ratio use centered cover behavior; repeat uses the asset's natural tile size from the top-left corner.","x":40,"y":0,"width":1940,"height":140,"color":"6"},
