		{"id":"title","type":"text","text":"# Stress and Boundary Canvas\n\nThis canvas intentionally combines negative coordinates, large bounds, mixed card sizes, dense edges, long labels, and distant islands. Export should finish without truncation, memory errors, or displaced geometry.","x":0,"y":-820,"width":2100,"height":260,"color":"6"},
